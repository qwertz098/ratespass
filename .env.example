# Kopieren nach .env (wird nicht eingecheckt) und anpassen.
ADMIN_TOKEN=                            # Zugang zu /admin, mind. 16 Zeichen: `openssl rand -hex 16` (leer/kürzer = Admin abgeschaltet)
VAPID_SUBJECT=mailto:du@example.org     # echte Kontaktadresse für Push-Dienste
HOST_PORT=3007                          # veröffentlichter Port auf dem Host (Container-intern bleibt 3000)
BIND_ADDRESS=0.0.0.0                    # 127.0.0.1 = nur vom Host selbst erreichbar
NPM_NETWORK=npm_default                 # nur docker-compose.npm.yml: Docker-Netzwerk von Nginx Proxy Manager (docker network ls)
PLAYER_CREATE_LIMIT_PER_HOUR=60          # neue Profile pro IP und Stunde (Missbrauchsschutz)
# --- Verantwortlicher (Impressum & Datenschutzerklärung) – Pflichtangaben, sonst zeigt die Erklärung Platzhalter ---
CONTROLLER_NAME=
CONTROLLER_ADDRESS=                     # ladungsfähige Anschrift
CONTROLLER_EMAIL=
# CONTROLLER_PHONE=
# DPO_CONTACT=                          # Datenschutzbeauftragte/r, falls benannt
# HOSTING_PROVIDER=                     # z. B. „Oracle Cloud, Region Frankfurt“
# PRIVACY_RETENTION_DAYS=730            # anonyme Profile ohne Aktivität werden danach gelöscht
# ANTHROPIC_API_KEY=                    # KI-Schnittstelle (Admin-Tab KI); ohne Schlüssel aus – nie committen
# AI_MODEL=claude-sonnet-5-5
# AI_DAILY_LIMIT=100                    # max. neu erzeugte Fragen pro Tag
# AI_AUTO=0                             # 1 = Auto-Lauf füllt Fragen-Lücken (landen in der Moderation)
PLAYER_REPORTS=1                        # 0 = Melde-Knopf (⚑) für alle Spieler abschalten (Reviewer/Admin bleiben)
PROXY_HOPS=1                            # 2, wenn Cloudflare-Proxy vor NPM sitzt
# TRUST_PROXY=1                         # nur docker-compose.yml: auf 1, wenn ein Reverse-Proxy davor steht
# RATESPASS_IMAGE=ghcr.io/qwertz098/ratespass:latest
