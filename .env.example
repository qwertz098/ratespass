# Kopieren nach .env (wird nicht eingecheckt) und anpassen.
ADMIN_TOKEN=                            # Zugang zu /admin, mind. 16 Zeichen: `openssl rand -hex 16` (leer/kürzer = Admin abgeschaltet)
VAPID_SUBJECT=mailto:du@example.org     # echte Kontaktadresse für Push-Dienste
HOST_PORT=3007                          # veröffentlichter Port auf dem Host (Container-intern bleibt 3000)
BIND_ADDRESS=0.0.0.0                    # 127.0.0.1 = nur vom Host selbst erreichbar
NPM_NETWORK=npm_default                 # nur docker-compose.npm.yml: Docker-Netzwerk von Nginx Proxy Manager (docker network ls)
DUEL_FORFEIT_DAYS=3                     # inaktive Duelle werden nach so vielen Tagen zugunsten des Wartenden beendet
DUEL_REMIND_HOURS=24                    # Push-Erinnerung an den Spieler am Zug
DUEL_TAKEOVER_HOURS=24                  # danach darf der Wartende mit einem Bot weiterspielen
PLAYER_CREATE_LIMIT_PER_HOUR=60          # neue Profile pro IP und Stunde (Missbrauchsschutz)
WORDLE_TZ=Europe/Berlin                 # Zeitzone für den Tageswechsel des täglichen Wordle (Wort des Tages)
# --- Betreiber / Verantwortlicher (Impressum & Datenschutzerklärung) ---------------------------------------------------
# Nur diese Angaben kommen aus der Umgebung; der übrige Text steht vorbereitet in legal/datenschutz.de.md und .en.md.
# Pflicht: CONTROLLER_NAME, CONTROLLER_ADDRESS, CONTROLLER_EMAIL (sonst zeigt die Erklärung „[nicht konfiguriert: …]“).
# Werte mit Leerzeichen/Kommas in Anführungszeichen setzen. Jede Änderung ändert die Textversion → alle stimmen einmal erneut zu.
CONTROLLER_NAME="Max Mustermann"                                  # Person oder Firma inkl. Rechtsform
CONTROLLER_ADDRESS="Musterstraße 1, 12345 Musterstadt, Deutschland"   # ladungsfähige Anschrift
CONTROLLER_EMAIL=datenschutz@example.org
CONTROLLER_PHONE=                                                 # optional
CONTROLLER_REPRESENTATIVE=                                        # optional: vertretungsberechtigte Person (bei Firmen)
CONTROLLER_REGISTER=                                              # optional: z. B. „Amtsgericht Musterstadt, HRB 12345“
CONTROLLER_VAT_ID=                                                # optional: USt-IdNr.
DPO_CONTACT=                                                      # optional: Datenschutzbeauftragte/r, falls benannt
SUPERVISORY_AUTHORITY=                                            # optional: zuständige Aufsichtsbehörde
HOSTING_PROVIDER="Oracle Cloud Infrastructure, Region Frankfurt"  # Hoster inkl. Standort (Auftragsverarbeitung abschließen)
PRIVACY_RETENTION_DAYS=730                                        # anonyme Profile ohne Aktivität werden danach gelöscht
# LEGAL_DIR=                                                      # optional: eigenes Verzeichnis mit datenschutz.de.md / datenschutz.en.md
# ANTHROPIC_API_KEY=                    # KI-Schnittstelle (Admin-Tab KI); ohne Schlüssel aus – nie committen
# AI_MODEL=claude-sonnet-5-5
# AI_DAILY_LIMIT=100                    # max. neu erzeugte Fragen pro Tag
# AI_AUTO=0                             # 1 = Auto-Lauf füllt Fragen-Lücken (landen in der Moderation)
PLAYER_REPORTS=1                        # 0 = Melde-Knopf (⚑) für alle Spieler abschalten (Reviewer/Admin bleiben)
PROXY_HOPS=1                            # 2, wenn Cloudflare-Proxy vor NPM sitzt
# TRUST_PROXY=1                         # nur docker-compose.yml: auf 1, wenn ein Reverse-Proxy davor steht
# RATESPASS_IMAGE=ghcr.io/qwertz098/ratespass:latest
