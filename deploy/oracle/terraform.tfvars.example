# Kopieren nach terraform.tfvars (wird nicht eingecheckt) und anpassen.
compartment_ocid = "ocid1.compartment.oc1..xxxxxxxx"
region           = "eu-frankfurt-1"                 # Home-Region deines Kontos

domain           = "quiz.example.org"
vapid_subject    = "mailto:du@example.org"
ssh_public_key   = "ssh-ed25519 AAAA… du@rechner"
ssh_allowed_cidr = "203.0.113.7/32"                 # deine eigene IP (curl -4 ifconfig.me) + /32

# Optional
# shape         = "VM.Standard.A1.Flex"   # oder "VM.Standard.E2.1.Micro" (AMD, 1 GB RAM)
# ocpus         = 1
# memory_in_gbs = 6
# auto_update   = false
# admin_token   = ""                       # leer = zufällig erzeugt
