{
  "name": "ratespass",
  "version": "0.1.0",
  "private": true,
  "description": "Ratespaß – minimalistischer Quizduell-Clon als PWA",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/main.ts",
    "dev": "node --watch --disable-warning=ExperimentalWarning server/main.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.ts\"",
    "check": "tsc --noEmit",
    "import": "node --disable-warning=ExperimentalWarning tools/import-batch.ts",
    "fetch:opentdb": "node --disable-warning=ExperimentalWarning tools/fetch-opentdb.ts",
    "fetch:wordlists": "node --disable-warning=ExperimentalWarning tools/fetch-wordlists.ts",
    "gen:wikidata": "node --disable-warning=ExperimentalWarning tools/gen-wikidata.ts",
    "todo:translate": "node --disable-warning=ExperimentalWarning tools/export-missing.ts",
    "backup": "node --disable-warning=ExperimentalWarning tools/backup.ts",
    "export:community": "node --disable-warning=ExperimentalWarning tools/export-community.ts",
    "apply:edits": "node --disable-warning=ExperimentalWarning tools/apply-edits.ts",
    "build:demo": "node tools/build-demo.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "web-push": "^3.6.7"
  }
}
